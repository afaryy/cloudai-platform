{
  "annotations": {
    "list": []
  },
  "description": "Synthetic metrics only. Temporary EKS sandbox; no production SLO or customer data.",
  "editable": false,
  "panels": [
    {
      "datasource": "${DS_PROMETHEUS}",
      "id": 1,
      "title": "Request rate and outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (route, outcome) (rate(cloudai_request_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "id": 2,
      "title": "Request latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(cloudai_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "id": 3,
      "title": "Token estimate and synthetic cost",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(cloudai_estimated_input_tokens_total[5m]))",
          "refId": "A"
        },
        {
          "expr": "sum(rate(cloudai_estimated_output_tokens_total[5m]))",
          "refId": "B"
        },
        {
          "expr": "sum(rate(cloudai_estimated_cost_usd_total[5m]))",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "id": 4,
      "title": "Policy and guardrail verdicts",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (verdict) (rate(cloudai_policy_verdict_total[5m]))",
          "refId": "A"
        },
        {
          "expr": "sum by (verdict) (rate(cloudai_guardrail_verdict_total[5m]))",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": "${DS_PROMETHEUS}",
      "id": 5,
      "title": "AgentOps and workflow state",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (decision, runtime_state) (cloudai_agentops_decision_total)",
          "refId": "A"
        },
        {
          "expr": "sum by (state) (cloudai_workflow_state_total)",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "synthetic-only",
    "temporary-eks-sandbox"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "CloudAI Mock API — Synthetic Sandbox",
  "uid": "cloudai-mock-api-sandbox",
  "version": 1
}
