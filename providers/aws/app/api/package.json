{
  "name": "@cloudai-platform/mock-genai-api",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "description": "Mock GenAI / LLM Gateway API for the CloudAI platform reference implementation.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/src/server.js",
    "start": "node dist/src/server.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/tests/**/*.test.js\"",
    "agent-eval:gate": "pnpm run build && node dist/src/scripts/runAgentEvaluationTelemetryGate.js",
    "bedrock:smoke": "pnpm run build && node dist/src/scripts/bedrockAdapterSmoke.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "prom-client": "15.1.3"
  }
}
