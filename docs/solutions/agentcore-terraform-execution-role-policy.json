{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedAgentCoreEcrRepository",
      "Effect": "Allow",
      "Action": ["ecr:CreateRepository"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "cloudai-platform",
          "aws:RequestTag/Environment": "agentcore-rag-sandbox"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Project", "Environment", "DataScope", "ManagedBy", "CostBoundary", "TeardownRequired", "CloudAISlice"]
        }
      }
    },
    {
      "Sid": "ManageOnlyTheAgentCoreEcrRepository",
      "Effect": "Allow",
      "Action": ["ecr:DeleteRepository", "ecr:DescribeRepositories", "ecr:GetLifecyclePolicy", "ecr:ListTagsForResource", "ecr:PutLifecyclePolicy", "ecr:TagResource", "ecr:UntagResource"],
      "Resource": "arn:aws:ecr:ap-southeast-2:${aws:PrincipalAccount}:repository/cloudai-platform-agentcore-rag-sandbox"
    },
    {
      "Sid": "DescribeEcrForTerraformStateRefresh",
      "Effect": "Allow",
      "Action": ["ecr:DescribeRepositories"],
      "Resource": "*"
    },
    {
      "Sid": "CreateOnlyNamedAgentCoreRoles",
      "Effect": "Allow",
      "Action": ["iam:CreateRole"],
      "Resource": "arn:aws:iam::${aws:PrincipalAccount}:role/cloudaiplatformagentcoreragsandbox-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "cloudai-platform",
          "aws:RequestTag/Environment": "agentcore-rag-sandbox"
        }
      }
    },
    {
      "Sid": "ManageOnlyNamedAgentCoreRoles",
      "Effect": "Allow",
      "Action": ["iam:DeleteRole", "iam:DeleteRolePolicy", "iam:GetRole", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListRoleTags", "iam:PutRolePolicy", "iam:TagRole", "iam:UntagRole", "iam:UpdateAssumeRolePolicy"],
      "Resource": "arn:aws:iam::${aws:PrincipalAccount}:role/cloudaiplatformagentcoreragsandbox-*"
    },
    {
      "Sid": "PassOnlySandboxRolesToAgentCore",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${aws:PrincipalAccount}:role/cloudaiplatformagentcoreragsandbox-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateAgentCoreRuntimeIdentityServiceLinkedRole",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::*:role/aws-service-role/runtime-identity.bedrock-agentcore.amazonaws.com/AWSServiceRoleForBedrockAgentCoreRuntimeIdentity",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "runtime-identity.bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateOnlyTaggedAgentCoreResources",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:CreateAgentRuntime", "bedrock-agentcore:CreateGateway"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "cloudai-platform",
          "aws:RequestTag/Environment": "agentcore-rag-sandbox"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["Project", "Environment", "DataScope", "ManagedBy", "CostBoundary", "TeardownRequired", "CloudAISlice"]
        }
      }
    },
    {
      "Sid": "CreateAgentCoreRuntimeWorkloadIdentity",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:CreateWorkloadIdentity"],
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-2:${aws:PrincipalAccount}:workload-identity-directory/default/workload-identity/*"
    },
    {
      "Sid": "ManageOnlyTaggedAgentCoreResources",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:DeleteAgentRuntime", "bedrock-agentcore:DeleteGateway", "bedrock-agentcore:GetAgentRuntime", "bedrock-agentcore:GetGateway", "bedrock-agentcore:ListTagsForResource", "bedrock-agentcore:TagResource", "bedrock-agentcore:UntagResource", "bedrock-agentcore:UpdateAgentRuntime", "bedrock-agentcore:UpdateGateway"],
      "Resource": ["arn:aws:bedrock-agentcore:ap-southeast-2:${aws:PrincipalAccount}:runtime/*", "arn:aws:bedrock-agentcore:ap-southeast-2:${aws:PrincipalAccount}:gateway/*"],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "cloudai-platform",
          "aws:ResourceTag/Environment": "agentcore-rag-sandbox"
        }
      }
    },
    {
      "Sid": "CreateAndManageTargetsOnlyForTaggedSandboxGateway",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:CreateGatewayTarget", "bedrock-agentcore:DeleteGatewayTarget", "bedrock-agentcore:GetGatewayTarget", "bedrock-agentcore:ListGatewayTargets", "bedrock-agentcore:UpdateGatewayTarget"],
      "Resource": "arn:aws:bedrock-agentcore:ap-southeast-2:${aws:PrincipalAccount}:gateway/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "cloudai-platform",
          "aws:ResourceTag/Environment": "agentcore-rag-sandbox"
        }
      }
    },
    {
      "Sid": "ListAgentCoreForTerraformStateRefresh",
      "Effect": "Allow",
      "Action": ["bedrock-agentcore:ListAgentRuntimes", "bedrock-agentcore:ListGateways"],
      "Resource": "*"
    }
  ]
}
