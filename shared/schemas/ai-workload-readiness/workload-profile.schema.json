{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudai-platform.example/schemas/ai-workload-readiness/workload-profile.schema.json",
  "title": "AI workload readiness profile",
  "description": "Metadata-only admission contract for future accelerated AI workloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workloadId",
    "profile",
    "owner",
    "dataClassification",
    "runtime",
    "capacity",
    "controls",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workloadId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "profile": {
      "type": "string",
      "enum": [
        "interactive-inference",
        "agent-rag-inference",
        "batch-inference",
        "fine-tuning",
        "distributed-training",
        "embeddings-rag-indexing"
      ]
    },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 240 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "service", "shutdownOwner"],
      "properties": {
        "team": { "type": "string", "minLength": 1, "maxLength": 80 },
        "service": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shutdownOwner": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "dataClassification": { "const": "synthetic-public" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "imagePolicy", "modelPolicy"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["kubernetes-gpu", "managed-endpoint", "queue-worker", "hyperpod-eks", "future-hpc"]
        },
        "imagePolicy": { "const": "approved-digest-only" },
        "modelPolicy": { "const": "approved-model-version-only" }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceleratorClass", "minAccelerators", "maxAccelerators", "queuePolicy"],
      "properties": {
        "acceleratorClass": {
          "type": "string",
          "enum": ["cpu", "gpu", "neuron", "mixed"]
        },
        "minAccelerators": { "type": "integer", "minimum": 0 },
        "maxAccelerators": { "type": "integer", "minimum": 0 },
        "queuePolicy": {
          "type": "string",
          "enum": ["reserved", "autoscale", "preemptible", "borrowed"]
        }
      }
    },
    "admission": {
      "description": "Design-only shared-capacity admission intent, aligned to Kueue concepts without declaring live Kubernetes resources.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceFlavor",
        "clusterQueue",
        "localQueue",
        "admissionChecks",
        "topologyIntent",
        "maxQueueWaitSeconds",
        "retryPolicy",
        "preemptionPolicy"
      ],
      "properties": {
        "resourceFlavor": { "type": "string", "minLength": 1, "maxLength": 120 },
        "clusterQueue": { "type": "string", "minLength": 1, "maxLength": 120 },
        "localQueue": { "type": "string", "minLength": 1, "maxLength": 120 },
        "cohort": { "type": "string", "minLength": 1, "maxLength": 120 },
        "borrowingLimit": { "type": "integer", "minimum": 0 },
        "admissionChecks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "budget-approved",
              "image-approved",
              "data-boundary-approved",
              "topology-ready",
              "human-approved"
            ]
          }
        },
        "topologyIntent": {
          "type": "string",
          "enum": [
            "none",
            "prefer-local",
            "required-single-domain",
            "required-multi-node-domain"
          ]
        },
        "gangScheduling": { "type": "boolean" },
        "maxQueueWaitSeconds": { "type": "integer", "minimum": 1 },
        "retryPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoffSeconds"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "backoffSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 }
          }
        },
        "preemptionPolicy": {
          "type": "string",
          "enum": [
            "never",
            "reclaim-within-cohort",
            "borrow-within-cohort",
            "within-queue"
          ]
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "budgetStopRequired",
        "teardownPlanRequired",
        "telemetryRequired",
        "checkpointRequired",
        "requiresHumanApproval"
      ],
      "properties": {
        "budgetStopRequired": { "const": true },
        "teardownPlanRequired": { "const": true },
        "telemetryRequired": { "const": true },
        "checkpointRequired": { "type": "boolean" },
        "requiresHumanApproval": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "signals"],
      "properties": {
        "mode": { "const": "metadata-only" },
        "signals": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "gpu-hours",
              "queue-time",
              "task-goodput",
              "latency",
              "error-rate",
              "checkpoint-duration",
              "cost-estimate",
              "energy-estimate"
            ]
          }
        }
      }
    }
  }
}
