{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixed synthetic agent evaluation scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "scenarioId",
    "syntheticOnly",
    "fixedPrompt",
    "expectedResponse",
    "expectedToolTrajectory",
    "assertions",
    "thresholdProfile"
  ],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "scenarioId": { "type": "string", "pattern": "^synthetic-[a-z0-9-]+$" },
    "syntheticOnly": { "const": true },
    "fixedPrompt": { "type": "string", "minLength": 1, "maxLength": 240 },
    "expectedResponse": { "type": "string", "minLength": 1, "maxLength": 360 },
    "expectedToolTrajectory": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "argumentsSubset"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "argumentsSubset": { "type": "object" }
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "citation-present",
          "abstained",
          "source-retired-denied",
          "provider-timeout",
          "tool-denied",
          "human-approval-required"
        ]
      }
    },
    "thresholdProfile": { "const": "strict-v1" }
  }
}
