{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudai-platform.example/schemas/ai-supplier-evidence/synthetic-evidence-manifest.schema.json",
  "title": "Synthetic supplier evidence manifest",
  "description": "Closed, metadata-only input contract for the local synthetic supplier evidence adapter.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "supplierAssessmentId",
    "evidenceFamily",
    "sourceReference",
    "sourceType",
    "sourceVersion",
    "observedAt",
    "validUntil",
    "contentDigest",
    "adapterId",
    "adapterVersion",
    "authenticityState",
    "redactionState",
    "submittedByRole",
    "submittedByPrincipalRef",
    "submittedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "supplierAssessmentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "evidenceFamily": {
      "type": "string",
      "enum": [
        "security-privacy",
        "ai-governance",
        "risk-compliance",
        "data-model-tool-lifecycle",
        "operations-resilience",
        "commercial-exit",
        "sustainability-location"
      ]
    },
    "sourceReference": { "type": "string", "format": "uri", "maxLength": 500 },
    "sourceType": { "const": "synthetic-manifest" },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "observedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "contentDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "adapterId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$" },
    "adapterVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "authenticityState": { "type": "string", "enum": ["verified", "failed", "unknown"] },
    "redactionState": { "type": "string", "enum": ["passed", "failed"] },
    "submittedByRole": { "type": "string", "minLength": 1, "maxLength": 120 },
    "submittedByPrincipalRef": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9:-]{2,120}$"
    },
    "submittedAt": { "type": "string", "format": "date-time" }
  }
}
