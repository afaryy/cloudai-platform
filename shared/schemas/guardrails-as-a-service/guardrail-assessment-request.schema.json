{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cloudai-platform/schemas/guardrails-as-a-service/guardrail-assessment-request.schema.json",
  "title": "Mock Guardrail Assessment Request",
  "description": "Metadata-only synthetic signal assessment. It must not contain raw prompts, personal data, or tool payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "policyProfile", "surface", "syntheticSignals"],
  "properties": {
    "requestId": { "type": "string" },
    "policyProfile": { "type": "string" },
    "surface": { "type": "string", "enum": ["model-gateway", "rag", "agent-action", "delivery"] },
    "syntheticSignals": {
      "type": "array",
      "minItems": 1,
      "oneOf": [
        {
          "maxItems": 1,
          "items": { "const": "none" }
        },
        {
          "items": { "type": "string", "enum": ["pii-detected", "prompt-injection", "jailbreak-attempt", "high-risk-action"] }
        }
      ]
    }
  }
}
