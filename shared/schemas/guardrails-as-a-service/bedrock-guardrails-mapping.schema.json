{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/cloudai-platform/schemas/guardrails-as-a-service/bedrock-guardrails-mapping.schema.json",
  "title": "Static Bedrock Guardrails Concept Mapping",
  "description": "A metadata-only, non-live mapping from synthetic local Guardrails as a Service outcomes to provider concepts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mappingVersion", "scope", "mappings", "deferredConcepts", "evidenceBoundary"],
  "properties": {
    "mappingVersion": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conceptual", "metadataOnly", "liveProviderConfiguration", "modelInvocation", "rawContentHandling", "providerEnforcementClaim"],
      "properties": {
        "conceptual": { "type": "boolean" },
        "metadataOnly": { "type": "boolean" },
        "liveProviderConfiguration": { "type": "boolean" },
        "modelInvocation": { "type": "boolean" },
        "rawContentHandling": { "type": "boolean" },
        "providerEnforcementClaim": { "type": "boolean" }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["syntheticSignals", "verdict", "reasonCode", "bedrockConcept", "futurePlacement"],
        "properties": {
          "syntheticSignals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["none", "pii-detected", "prompt-injection", "jailbreak-attempt", "high-risk-action"] }
          },
          "verdict": { "type": "string", "enum": ["allow", "redact", "deny", "approval-required"] },
          "reasonCode": { "type": "string", "enum": ["no_synthetic_risk_signal", "synthetic_pii_signal", "synthetic_prompt_injection_signal", "synthetic_high_risk_action_signal"] },
          "bedrockConcept": { "type": "string", "enum": ["content-filter-prompt-attack", "sensitive-information-filter", "external-human-approval-control", "no-intervention-inferred"] },
          "futurePlacement": { "type": "string", "enum": ["pre-model-input", "input-or-output", "pre-tool-action", "not-applicable"] }
        }
      }
    },
    "deferredConcepts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "reason"],
        "properties": {
          "concept": { "type": "string", "enum": ["denied-topics", "word-filters", "contextual-grounding-checks", "provider-traces"] },
          "reason": { "type": "string" }
        }
      }
    },
    "evidenceBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "prohibited"],
      "properties": {
        "permitted": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "prohibited": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
