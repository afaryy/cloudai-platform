{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudai-platform.example/schemas/agentcore-readiness/knowledge-lookup-admission-request.schema.json",
  "title": "Synthetic AgentCore Knowledge-Lookup Admission Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "owner",
    "workloadIdentity",
    "route",
    "capability",
    "accessMode",
    "knowledgeBoundaryId",
    "riskTier",
    "sessionLimit",
    "budgetLimit",
    "requestedAt"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "workloadIdentity": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "enum": ["gateway-only"] },
    "capability": { "type": "string", "enum": ["knowledge-search"] },
    "accessMode": { "type": "string", "enum": ["read-only"] },
    "knowledgeBoundaryId": { "type": "string", "minLength": 1 },
    "riskTier": { "type": "string", "enum": ["standard", "elevated"] },
    "sessionLimit": { "type": "number", "minimum": 1 },
    "budgetLimit": { "type": "number", "minimum": 1 },
    "requestedAt": { "type": "string", "format": "date-time" }
  }
}
