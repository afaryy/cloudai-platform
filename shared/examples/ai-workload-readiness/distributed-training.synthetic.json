{
  "schemaVersion": "1.0",
  "workloadId": "synthetic-distributed-training",
  "profile": "distributed-training",
  "purpose": "Validate a topology-aware multi-node training contract with synthetic data.",
  "owner": {
    "team": "synthetic-ml-platform",
    "service": "distributed-training-lab",
    "shutdownOwner": "platform-operations@example.invalid"
  },
  "dataClassification": "synthetic-public",
  "runtime": {
    "type": "future-hpc",
    "imagePolicy": "approved-digest-only",
    "modelPolicy": "approved-model-version-only"
  },
  "capacity": {
    "acceleratorClass": "gpu",
    "minAccelerators": 8,
    "maxAccelerators": 32,
    "queuePolicy": "reserved"
  },
  "controls": {
    "budgetStopRequired": true,
    "teardownPlanRequired": true,
    "telemetryRequired": true,
    "checkpointRequired": true,
    "requiresHumanApproval": true
  },
  "evidence": {
    "mode": "metadata-only",
    "signals": [
      "gpu-hours",
      "checkpoint-duration",
      "energy-estimate",
      "task-goodput"
    ]
  }
}
